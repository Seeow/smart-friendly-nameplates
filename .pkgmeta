package-as: SmartFriendlyNameplates
enable-nolib-creation: no

# Lift the existing addon directory into the package root. Root README and
# LICENSE files remain alongside the TOC, without a second wrapper directory.
move-folders:
  SmartFriendlyNameplates/SmartFriendlyNameplates: SmartFriendlyNameplates

ignore:
  - AGENTS.md
  - docs
  - scripts
  - tests
  - dist
  - node_modules
  - CHANGELOG.md

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
